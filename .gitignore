# =========================
# Game Dev & Asset Files
# =========================

# Blender backup and auto-save files (CRITICAL)
# Blender creates a .blend1 file every time you save. If you don't ignore these, 
# you will be committing a duplicate of your entire 3D model history every single commit!
*.blend1
*.blend2
*.blend@

# LMMS / Audio backup files (Just in case)
*.mmpz.bak
*.bak

# =========================
# OS Generated Junk
# =========================

# Windows thumbnail caches and folder configs
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# macOS folder attributes (Good practice if you ever share the code)
.DS_Store
.AppleDouble
.LSOverride

# =========================
# Extra C++ Tooling
# =========================

# Visual Studio (Just in case you or someone else accidentally opens it in VS instead of Rider)
.vs/
*.user
*.suo

# Clangd language server cache (If you ever switch back to VS Code)
.clangd/

# Unwanted imgui config file 
imgui.ini